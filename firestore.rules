rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ১. স্কুলের মূল কনফিগ ও নোটিশ ডেটা (Marquee, Phone, Notices, Stats)
    // পাবলিক সাইট শুধু পড়তে পারবে, অ্যাডমিন প্যানেল আপডেট করতে পারবে
    match /school_data/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ২. ওয়েবসাইট থেকে পাঠানো যোগাযোগ অনুসন্ধান বার্তা (Contact Messages)
    // পাবলিক ভিজিটররা নতুন মেসেজ তৈরি (create) করতে পারবে
    // অ্যাডমিন সমস্ত বার্তা দেখতে ও মুছতে পারবে
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ৩. অনলাইন ভর্তি আবেদন (Admissions)
    match /admissions/{admissionId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}

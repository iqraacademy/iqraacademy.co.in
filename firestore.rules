rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validate string length and non-empty
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Helper: Validate 10-digit Indian phone number
    function isValidPhone(val) {
      return val is string && val.matches('^[0-9+\-\s]{10,15}$');
    }

    // Helper: Ensure Honeypot field is empty (Anti-Bot Protection)
    function isNotBot() {
      return !('bot_honeypot' in request.resource.data) || request.resource.data.bot_honeypot == "";
    }

    // 1. Public School Configuration (Marquee, Stats, Banners, Notices, Counter)
    match /school_data/{docId} {
      allow read: if true;
      // Allow admission_counter update during genuine form submission, or full write by Admin
      allow write: if docId == 'admission_counter'
                   || request.auth != null
                   || (request.resource.data.keys().hasAny(['marquee', 'stats', 'banners', 'notices', 'phone1', 'adminPinHash']));
    }

    // 2. Standalone Notices Collection
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if true; // Controlled via Admin Portal PIN / Firebase Auth
    }

    // 3. Online Admission Submissions (Strict Anti-Bot Schema Validation on Create)
    match /admissions/{admissionId} {
      allow read: if true;
      allow create: if isNotBot()
                    && isValidString(request.resource.data.name, 2, 120)
                    && isValidString(request.resource.data.fatherName, 2, 120)
                    && isValidPhone(request.resource.data.phone)
                    && isValidString(request.resource.data.className, 1, 40)
                    && isValidString(request.resource.data.stream, 2, 80)
                    && request.resource.data.timestamp is number;
      allow update, delete: if true;
    }

    // 4. Public Contact Form Messages (Strict Anti-Bot Schema Validation on Create)
    match /contact_messages/{msgId} {
      allow read: if true;
      allow create: if isNotBot()
                    && isValidString(request.resource.data.name, 2, 100)
                    && isValidPhone(request.resource.data.phone)
                    && isValidString(request.resource.data.message, 3, 2000)
                    && request.resource.data.timestamp is number;
      allow update, delete: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public visitors can read live video, posts, and look up their 4-digit registration status
    match /public_feed/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "matinbanganur@gmail.com";
    }
    match /submissions/{regId} {
      allow read: if regId.matches('^[0-9]{4}$');
      allow create: if regId.matches('^[0-9]{4}$')
                    && request.resource.data.name is string
                    && request.resource.data.mobile is string
                    && request.resource.data.purpose is string
                    && request.resource.data.message is string
                    && request.resource.data.status == 'pending';
      allow update, delete: if request.auth != null && request.auth.token.email == "matinbanganur@gmail.com";
    }
  }
}
